# Copy to .env.local for development. Never commit real values.

# --- Environment identity (drives the coloured strip; see §9 of the build guide) ---
# one of: local | sandbox | production
APP_ENV=local

# --- Database ---
# PostgreSQL 16 with the TimescaleDB extension available.
DATABASE_URL=postgres://portal:portal@localhost:5432/portal
# Separate superuser URL used only by migrations (needed for REVOKE / trigger DDL).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/portal

# --- Auth ---
# 32+ random bytes, base64. Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Object storage (S3-compatible, object lock enabled) ---
S3_ENDPOINT=
S3_BUCKET=portal-vault
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- I-REC registry ---
# 'mock' in local, sandbox registry URL in sandbox, live URL in production.
REGISTRY_MODE=mock
REGISTRY_API_URL=
REGISTRY_API_KEY=

# --- E-signature provider ---
ESIGN_PROVIDER=mock
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=

# --- Errors ---
SENTRY_DSN=
